# Copy to .env and adjust. Every value below has a working default in
# docker-compose.yml, so the stack also starts with no .env at all.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
ANALYTICS_DB=analytics
POSTGRES_PORT=5432

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=raw-data
MINIO_PREFIX=sales/
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Airflow ----------------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Generate your own for anything beyond local use:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=ZmRfcGxhdGZvcm1fZGVtb19mZXJuZXRfa2V5XzEyMzQ=
AIRFLOW_SECRET_KEY=mini-data-platform-secret
# Signs the JWTs task processes use against the Task Execution API.
AIRFLOW_JWT_SECRET=mini-data-platform-jwt-secret
# On Linux set this to your own uid (`id -u`) so mounted logs stay writable.
AIRFLOW_UID=50000

# --- Metabase ---------------------------------------------------------------
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=Metabase123!
# JVM heap cap. Raise on a roomy machine; lower if Docker is memory-starved.
METABASE_MAX_HEAP=768m

# --- Images -----------------------------------------------------------------
AIRFLOW_IMAGE=mini-data-platform/airflow
GENERATOR_IMAGE=mini-data-platform/data-generator
IMAGE_TAG=local
TZ=UTC
